#include <iostream>
#include <signal.h>
#include "TCPClient.h"

TCPClient tcp;    // наш основной классс

// обработчик выхода из программы
void sig_exit (int s)
{
   tcp.exit();    // вызов метода exit()
   exit(0);       
}

int main(int argc, char *argv[])
{
      // установка обработчика выхода из программы
