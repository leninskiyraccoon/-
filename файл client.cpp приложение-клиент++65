          tcp.Send(to_string(rand()%25000));
          // получаем ответ сервера
          string rec = != "" )
          {
                   // выводим ответ сервера
                   cout << "Server Responde:" << rec << end1;
          }
          sleep(1);               // засыпаем на 1 секунду
      }
      return 0;
}
